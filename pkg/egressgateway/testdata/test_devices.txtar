kind: CiliumEndpoint
metadata:
  generation: 1
  labels:
    name: client1
    foo: bar
  name: client1-795488bf5-2tplm
  namespace: test1
  uid: 7c22952d-25a0-409d-952c-60895b5c2a90
status:
  id: 2000
  identity:
    id: 1000
    labels:
    - k8s:foo=bar
  networking:
    addressing:
    - ipv4: 10.244.3.91
      ipv6: fd00:10:244:3::9c94
    node: 172.18.0.5
  state: ready
-- device-egw0.yaml --
index: 1
name: egw0
addrs:
  - addr: 10.10.0.1
  - addr: fd00::10:10:0:1
type: veth
flags: 1 # admin-up
operstatus: up
selected: true
