kind: CiliumNode
metadata:
  generation: 1
  labels:
    kubernetes.io/hostname: kind-worker
    foo: bar
  name: localnode1
  uid: 00000000-0000-0000-0000-000000000000
spec:
  addresses:
  - ip: 172.18.0.3
    type: InternalIP
-- policy1.yaml --
apiVersion: cilium.io/v2
kind: CiliumEgressGatewayPolicy
metadata:
  generation: 1
  name: policy1
  uid: 00000000-0000-0000-0000-000000000000
spec:
  destinationCIDRs:
  - 0.0.0.0/0
  - ::/0
  egressGateway:
    interface: egw0
    nodeSelector:
      matchLabels:
        kubernetes.io/hostname: kind-worker
  excludedCIDRs: []
  selectors:
  - podSelector:
      matchLabels:
        foo: bar
-- ciliumendpoint1.yaml --
